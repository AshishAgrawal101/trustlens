{
  "id": "/phone/",
  "name": "TrustLens Pocket",
  "short_name": "TrustLens",
  "description": "A private on-device guide for requests in shared messages.",
  "start_url": "/phone/",
  "scope": "/phone/",
  "display": "standalone",
  "background_color": "#071f25",
  "theme_color": "#09272d",
  "icons": [
    {
      "src": "/phone/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/phone/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "share_target": {
    "action": "/phone/share",
    "method": "POST",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "shortcuts": [
    {
      "name": "Already acted? Recovery steps",
      "short_name": "Recovery",
      "description": "Open a fixed recovery checklist without sharing incident details.",
      "url": "/phone/#recovery",
      "icons": [
        {
          "src": "/phone/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Practice safer decisions",
      "short_name": "Practice",
      "description": "Try six constructed scenarios offline.",
      "url": "/phone/#practice",
      "icons": [
        {
          "src": "/phone/icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ]
}

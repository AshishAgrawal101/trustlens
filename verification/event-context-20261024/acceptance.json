{
  "frozen_before_event_implementation_read_or_run": true,
  "oracle": "Python datetime.date subtraction on supplied ISO calendar dates; independent of JS Date/timezone",
  "base_input": {
    "claim": "Constructed site closure claim",
    "aUrl": "https://a.example/report",
    "aQuote": "Services continue.",
    "aDate": "2024-02-28",
    "bUrl": "https://b.example/report",
    "bQuote": "Repairs are planned.",
    "bDate": "2024-03-01"
  },
  "cases": [
    {
      "id": "absent",
      "eventDate_omitted": true,
      "expected": "exact prefeature observations/questions/steps/labels/nextStep; PLAN unchanged"
    },
    {
      "id": "empty",
      "eventDate": "",
      "expected": "exact absent output"
    },
    {
      "id": "blank-ascii",
      "eventDate": "          ",
      "expected": "exact absent output"
    },
    {
      "id": "leap-before-after",
      "eventDate": "2024-02-29",
      "aDate": "2024-02-28",
      "bDate": "2024-03-01",
      "expected_observations": [
        {
          "id": "dates:a:before",
          "calendar_day_gap": 1
        },
        {
          "id": "dates:b:after",
          "calendar_day_gap": 1
        }
      ],
      "fixed_event_question": true,
      "verdict": "no source/date/truth inference"
    },
    {
      "id": "same-day",
      "eventDate": "2024-02-29",
      "aDate": "2024-02-29",
      "bDate": "",
      "expected_observations": [
        {
          "id": "dates:a:same",
          "calendar_day_gap": 0
        }
      ],
      "fixed_event_question": true,
      "verdict": "no source/date/truth inference"
    },
    {
      "id": "nonleap-boundary",
      "eventDate": "2023-02-28",
      "aDate": "2023-03-01",
      "bDate": "",
      "expected_observations": [
        {
          "id": "dates:a:after",
          "calendar_day_gap": 1
        }
      ],
      "fixed_event_question": true,
      "verdict": "no source/date/truth inference"
    },
    {
      "id": "year-boundary",
      "eventDate": "2025-01-01",
      "aDate": "2024-12-31",
      "bDate": "",
      "expected_observations": [
        {
          "id": "dates:a:before",
          "calendar_day_gap": 1
        }
      ],
      "fixed_event_question": true,
      "verdict": "no source/date/truth inference"
    },
    {
      "id": "century-leap",
      "eventDate": "2000-02-29",
      "aDate": "2000-03-01",
      "bDate": "",
      "expected_observations": [
        {
          "id": "dates:a:after",
          "calendar_day_gap": 1
        }
      ],
      "fixed_event_question": true,
      "verdict": "no source/date/truth inference"
    },
    {
      "id": "future-claim",
      "eventDate": "2030-01-01",
      "aDate": "2029-12-31",
      "bDate": "",
      "expected_observations": [
        {
          "id": "dates:a:before",
          "calendar_day_gap": 1
        }
      ],
      "fixed_event_question": true,
      "verdict": "no source/date/truth inference"
    },
    {
      "id": "invalid-event-dates",
      "values": [
        "1900-02-29",
        "2023-02-29",
        "2024-02-30",
        "2024-13-01",
        "24-02-29",
        "2024-02-29T00:00:00Z"
      ],
      "expected": "fixed private validation error"
    },
    {
      "id": "invalid-type-or-size",
      "values": [
        null,
        true,
        123,
        [],
        {},
        " 2024-02-29",
        "           "
      ],
      "expected": "fixed private validation error; raw length cap10beforetrim"
    },
    {
      "id": "no-publication-dates",
      "eventDate": "2024-02-29",
      "aDate": "",
      "bDate": "",
      "expected_observations": [],
      "fixed_event_question": true
    },
    {
      "id": "date-only-not-an-account",
      "eventDate": "2024-02-29",
      "aDate": "2024-02-28",
      "bDate": "",
      "aUrl": "",
      "aQuote": "",
      "bUrl": "",
      "bQuote": "",
      "expected_observations": [],
      "fixed_event_question": true
    }
  ],
  "interface": "optional eventDate; absent/empty after allowed trim preserves exact old outputs; rawmax10/type/calendar strict; observations dates:a|b:before|same|after only account with URL/quote; PLAN unchanged",
  "cross_cutting": [
    "source publication labels and claimed event date supplied/unverified",
    "calendar chronology does not establish source reliability/independence/truth/causation",
    "fixed exports omit dates/claim/source data",
    "no timezone/event time inferred"
  ]
}

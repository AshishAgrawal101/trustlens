{
  "version": 1,
  "status": "frozen_before_module_exists_and_predictions",
  "purpose": "Exact supplied-text location acceptance, not source authenticity or semantic evaluation.",
  "limits": {
    "quote_utf16": 4000,
    "source_utf16": 30000,
    "returned_matches": 5,
    "context_utf16_each_side": 160,
    "surrogate_adjustment": "May extend context by one UTF16 unit to avoid cutting a pair."
  },
  "invariants": [
    "Exact case/whitespace/punctuation matching; no normalization or ellipsis interpretation.",
    "Nonoverlapping occurrences: advance indexOf search by quote.length after each match.",
    "Count all occurrences but return first five; truncated exactly total>5.",
    "Offsets are actual JavaScript UTF16 start/end; text equals source.slice(start,end) and unchanged quote.",
    "before/after are exact adjacent source slices, up to160units or161if needed to keep surrogate pair intact.",
    "Strict strings, nonblank trimmed checks only; original content never trimmed or rewritten.",
    "Fixed errors never echo private content. No network/storage.",
    "Not found does not prove fake quotation; found does not authenticate source, identify author or interpret meaning."
  ],
  "cases": [
    {
      "id": "ordinary",
      "quote": "opens",
      "source": "The park opens today.",
      "expected_total": 1,
      "expected_starts": [
        9
      ],
      "expected_truncated": false
    },
    {
      "id": "repeat-capped",
      "quote": "x",
      "source": "x x x x x x",
